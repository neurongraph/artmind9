# Artmind Configuration
ARTMIND_USER="your first name"

# ── Run folder & data location ────────────────────────────────────────────────
# ARTMIND_HOME is the run folder (config, skills, domain schemas, logs). It is
# located BEFORE this file is read, so set it as a real environment variable if
# you want to override the default (~/.artmind) — setting it here has no effect.
#
# ARTMIND_DATA_DIR is ingestion-only storage (originals, markdowns, registry db,
# jobs, kg staging, snapshots). Query/serve/web-ui never touch it. Default is
# ~/artmind-data; point it anywhere (e.g. an external drive) or omit on a
# query-only host.
ARTMIND_DATA_DIR=

# Knowledge Graph — LLM provider: "ollama" (default, local/free) or "openrouter"
# (cloud, paid). This one setting controls BOTH the KG extraction model AND the
# image description model below — everything downstream must match it.
ARTMIND_KG_LLM_PROVIDER=ollama
# ARTMIND_KG_LLM_PROVIDER=openrouter

# For Ollama: local server URL. For OpenRouter: leave blank to use the default
# https://openrouter.ai/api/v1
ARTMIND_KG_LLM_URL=http://localhost:11434
# ARTMIND_KG_LLM_URL=https://openrouter.ai/api/v1

# For Ollama: e.g. qwen3.6:35b-a3b-coding-nvfp4. For OpenRouter: a namespaced
# model slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet. If left
# unset, defaults to ministral-3:14b for ollama or google/gemma-4-31b-it for
# openrouter.
ARTMIND_KG_LLM_MODEL=qwen3.6:35b-mlx
# ARTMIND_KG_LLM_MODEL=google/gemma-4-31b-it

# Image description model. MUST use a model compatible with the provider set
# in ARTMIND_KG_LLM_PROVIDER above — there is no automatic translation between
# providers. Default (Ollama) is gemma4:e4b. If ARTMIND_KG_LLM_PROVIDER is
# openrouter, this must be a vision-capable OpenRouter model slug (e.g.
# openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001)
# — not every OpenRouter model supports image input, and there is no
# automatic default here.
ARTMIND_IMAGE_MODEL=gemma4:e4b
# ARTMIND_IMAGE_MODEL=openai/gpt-4o-mini   # openrouter equivalent

# Required only when ARTMIND_KG_LLM_PROVIDER=openrouter — get a key at
# https://openrouter.ai/keys
ARTMIND_OPENROUTER_API_KEY=

# Timeout in seconds for LLM requests, both Ollama and OpenRouter (default: 120)
ARTMIND_OLLAMA_TIMEOUT=600

# Knowledge Graph — Neo4j connection
ARTMIND_KG_NEO4J_URI=neo4j://127.0.0.1:7687
ARTMIND_KG_NEO4J_USERNAME=xxxx
ARTMIND_KG_NEO4J_PASSWORD=xxxx
ARTMIND_KG_NEO4J_DATABASE=xxxx

# Knowledge Graph — Embeddings provider: "ollama" ONLY for now. OpenRouter has
# no embeddings API, so embeddings stay on Ollama even when
# ARTMIND_KG_LLM_PROVIDER above is set to openrouter.
ARTMIND_KG_EMBEDDINGS_PROVIDER=ollama
ARTMIND_KG_EMBEDDINGS_URL=http://localhost:11434
ARTMIND_KG_EMBEDDINGS_MODEL=nomic-embed-text:latest
ARTMIND_KG_EMBEDDING_DIMENSIONS=768

# Knowledge Graph — Chunking
# Max characters per chunk sent to the LLM (default: 6000 ≈ 1500 tokens for nomic-embed-text)
ARTMIND_KG_CHUNK_SIZE=7500

# Knowledge Graph — Ingestion concurrency
# How many chunks of a document are extracted in parallel (each chunk = its own
# embedding + entity/property/relationship LLM calls). Leave unset to use the
# provider-aware default: 4 for openrouter (cloud APIs serve concurrent requests,
# so this is a real speedup), 1 for ollama (a local single-GPU server serializes
# anyway, so parallelism doesn't help). Raise it only on openrouter; if you start
# seeing HTTP 429 "Too Many Requests", lower it. Overridable per-run with
# `artmind ingest extract-kg --maxWorkers N`.
# ARTMIND_INGEST_MAX_WORKERS=4
