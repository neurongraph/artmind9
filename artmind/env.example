# artmind — machine-wide configuration.
#
# Shared by every vault on this machine: LLM provider, API keys, embedding
# model, and the chat/admin-UI's own agent model. The line is "secrets and
# models belong to the machine; knowledge belongs to the vault"
# (docs/vault.md, "Machine-level config").
#
# What is deliberately NOT here: Neo4j connection, data location, and vault
# path. Those are vault-scoped now — `artmind init` writes them into
# `<vault>/.artmind/config.env`, one graph per vault. A key here can never
# override that file (paths.py loads the vault's own config.env first, and
# ignores a vault-scoped key found here instead — see paths.py's
# `_VAULT_ONLY_ENV_KEYS`), so there is nothing to gain by adding them back.
#
# `just dev-install` seeds this file (as `~/.artmind/config.env`) the first
# time there's nothing to seed it from; `artmind setup`/`artmind init` do the
# same on any later run. Never overwritten once it exists.
ARTMIND_USER="Your Name"


# ═══════════════════════════════════════════════════════════════════════════
# LLM provider — the ONE switch. Everything below in this block feeds KG
# extraction, image description, entity merge decisions, conflict detection,
# `artmind update`, text2cypher, text2sql, structured-store curation, and
# description synthesis. (Embeddings are a separate always-Ollama block further
# down; the chat/admin-UI's own conversational model is separate too —
# ARTMIND_SDK_MODEL / ARTMIND_ACP_MODEL, at the bottom.)
# ═══════════════════════════════════════════════════════════════════════════
#
# Quick reference — defaults per provider (leave *_MODEL unset to get these):
#
#   provider    text model                  image model
#   ollama      ministral-3:14b             gemma4:e4b
#   openrouter  google/gemma-4-31b-it       (no default — must be vision-capable,
#                                             e.g. openai/gpt-4o-mini)
#   ibm_ica     (no default — your          (same endpoint — check it supports
#                endpoint's Claude model id) vision before relying on it)
#
ARTMIND_KG_LLM_PROVIDER=ollama
# ARTMIND_KG_LLM_PROVIDER=openrouter
# ARTMIND_KG_LLM_PROVIDER=ibm_ica

# Text model — KG extraction, merges, conflicts, update, text2cypher/sql, curation, synthesis.
ARTMIND_KG_LLM_MODEL=ministral-3:14b
# ARTMIND_KG_LLM_MODEL=google/gemma-4-31b-it   # openrouter equivalent

# Image description model. MUST be compatible with the provider selected above
# — there is no automatic translation between providers.
ARTMIND_IMAGE_MODEL=gemma4:e4b
# ARTMIND_IMAGE_MODEL=openai/gpt-4o-mini   # openrouter equivalent (vision-capable)

# Timeout in seconds for LLM requests — applies to all three providers (default: 120)
ARTMIND_OLLAMA_TIMEOUT=600

# ── ollama connection (used when ARTMIND_KG_LLM_PROVIDER=ollama) ───────────────
ARTMIND_KG_LLM_URL=http://localhost:11434

# ── openrouter credentials (used when ARTMIND_KG_LLM_PROVIDER=openrouter) ──────
# Get a key at https://openrouter.ai/keys
ARTMIND_OPENROUTER_API_KEY=
# Leave ARTMIND_KG_LLM_URL blank above to use the default https://openrouter.ai/api/v1

# ── enterprise Anthropic-compatible endpoint (ARTMIND_KG_LLM_PROVIDER=ibm_ica) ──
# Some enterprises host an Anthropic-compatible inference endpoint (Claude Code)
# with a stable base URL and a static auth token. The code maps these into the
# existing OpenRouter client path, so the same request shape is used.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=


# ═══════════════════════════════════════════════════════════════════════════
# Embeddings — always Ollama, independent of the LLM provider above. OpenRouter
# has no embeddings API, so this stays on Ollama even when ARTMIND_KG_LLM_PROVIDER
# is openrouter or ibm_ica.
# ═══════════════════════════════════════════════════════════════════════════
ARTMIND_KG_EMBEDDINGS_PROVIDER=ollama
ARTMIND_KG_EMBEDDINGS_URL=http://localhost:11434
ARTMIND_KG_EMBEDDINGS_MODEL=nomic-embed-text:latest
ARTMIND_KG_EMBEDDING_DIMENSIONS=768


# ── Knowledge Graph — Chunking ───────────────────────────────────────────────────
# Max characters per chunk sent to the LLM (default: 6000 ≈ 1500 tokens for nomic-embed-text)
ARTMIND_KG_CHUNK_SIZE=7500

# ── Knowledge Graph — Ingestion concurrency ──────────────────────────────────────
# How many chunks of a document are extracted in parallel (each chunk = its own
# embedding + entity/property/relationship LLM calls). Leave unset to use the
# provider-aware default: 4 for openrouter (cloud APIs serve concurrent requests,
# so this is a real speedup), 1 for ollama (a local single-GPU server serializes
# anyway, so parallelism doesn't help). Raise it only on openrouter; if you start
# seeing HTTP 429 "Too Many Requests", lower it. Overridable per-run with
# `artmind ingest extract-kg --maxWorkers N`.
ARTMIND_INGEST_MAX_WORKERS=4


# ═══════════════════════════════════════════════════════════════════════════
# Chat UI / admin UI — agent model. Independent of the LLM provider block
# above: this is the conversational chat/admin-UI agent's own model, never
# used for KG work. Applies to both `artmind chat-ui` and `artmind admin-ui`
# (each also takes a `--model` flag that beats these env vars for that run).
# ═══════════════════════════════════════════════════════════════════════════
#
# claude-sdk backend (default; spawns the `claude` CLI). Leave unset to use
# the CLI's own default model resolution (your global `claude` login/config)
# — which can silently resolve to a model alias your account or endpoint
# doesn't have, surfacing as "Agent error: There's an issue with the selected
# model ... It may not exist or you may not have access to it." Set this to
# pin a model explicitly instead, e.g. claude-sonnet-5 or claude-opus-5.
ARTMIND_SDK_MODEL=claude-haiku-4-5
# Optional: model the SDK automatically retries with if the one above (or the
# CLI's default) comes back overloaded.
ARTMIND_SDK_FALLBACK_MODEL=claude-sonnet-5

# Optional: route the claude-sdk backend through a custom Anthropic-compatible
# endpoint (e.g. an enterprise gateway), independent of ARTMIND_KG_LLM_URL /
# ANTHROPIC_BASE_URL above (those feed a different, OpenAI-style client). Two
# gotchas: (1) the `claude` CLI appends /v1/messages itself, so if your
# gateway's KG-facing URL ends in /v1 (typical), this one must NOT — e.g. KG
# uses https://gateway/ica/v1, this wants https://gateway/ica; getting it
# wrong shows up as the same misleading "model may not exist" error above, so
# check `claude --debug-file <path>` for the real HTTP status if this is set
# and chat still fails. (2) Setting this alone does nothing useful if you're
# also logged into a claude.ai/console subscription (`claude auth status`) —
# the CLI prefers that OAuth session over ANTHROPIC_AUTH_TOKEN/API_KEY and the
# gateway then rejects its session credential. When this var is set, artmind
# also isolates the subprocess's CLAUDE_CONFIG_DIR (under $ARTMIND_HOME) so it
# can't see that login and falls back to pure env-var auth — your personal
# `claude` login elsewhere is untouched. ANTHROPIC_AUTH_TOKEN/API_KEY must
# still be set in this file (as it already is for ibm_ica) — it's inherited
# by the subprocess as-is; only the base URL and config dir are overridden.
ARTMIND_SDK_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica

# acp backend (only relevant when ARTMIND_ACP_AGENT_CMD selects one, e.g.
# opencode). Model for the ACP agent process, e.g. anthropic/claude-sonnet-4
# or ollama/gemma4:26b-mlx. For opencode specifically, this is passed via
# OPENCODE_CONFIG_CONTENT since opencode's `acp` subcommand has no --model
# flag. Leave unset to use the ACP agent's own default config.
ARTMIND_ACP_MODEL=openrouter/deepseek/deepseek-v4-flash
