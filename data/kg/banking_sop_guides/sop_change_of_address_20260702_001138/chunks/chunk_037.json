      ],
      "entity_class": "PROCESS",
      "type": "change_of_address",
      "description": "A procedure for updating a customer's address when they are moving to a holiday home for a limited duration, such as 3 months. The process offers two options: treating the change as permanent or marking it as temporary with a defined return date.",
