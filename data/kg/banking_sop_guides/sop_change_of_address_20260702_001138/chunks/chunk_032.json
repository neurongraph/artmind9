      "description": "A branching point to determine if standing orders have recipient addresses that require updating. This leads to three different scenarios (A, B, or C) based on the account relationship.",
      "context": [
        "Do standing orders have recipient addresses that need updating?"
      ]
    },
    {
      "id": "stp_001",
      "name": "Internal Standing Order Verification",
      "aliases": [
        "Scenario A"
      ],
      "entity_class": "PROCESS_STEP",
      "type": "system_recording",
      "description": "A check for standing orders directed to another FirstUK Bank account. Since these use account numbers rather than addresses, no further action is required and processing continues normally.",
      "context": [
        "Scenario A: Standing Order to Another FirstUK Bank Account",
        "No action needed",
        "Standing order uses account numbers, not addresses",
        "Continue processing normally"
      ]
    },
