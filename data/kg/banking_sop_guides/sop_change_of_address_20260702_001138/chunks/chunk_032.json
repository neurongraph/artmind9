      "id": "stp_004",
      "name": "External Outgoing Standing Order Verification",
      "aliases": [
        "Scenario C"
      ],
      "entity_class": "PROCESS_STEP",
      "type": "system_recording",
      "description": "A check for standing orders sent from the customer to an external party. It is determined that the sender's address change does not affect the standing order, allowing processing to continue.",
      "context": [
        "Scenario C: Standing Order FROM This Customer to External Party",
        "No recipient address change needed",
        "Sender's address change doesn't affect standing order",
        "Continue processing"
      ]
    },
