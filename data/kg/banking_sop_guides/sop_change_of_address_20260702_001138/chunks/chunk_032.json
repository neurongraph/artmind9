      "id": "stp_002",
      "name": "External Recipient Address Verification",
      "aliases": [
        "Scenario B"
      ],
      "entity_class": "PROCESS_STEP",
      "type": "data_collection",
      "description": "A step where the staff asks the customer if the recipient's address for an external bank standing order is still correct. This determines if a separate address update process is necessary.",
      "context": [
        "Scenario B: Standing Order to External Bank (Recipient May Have Moved)",
        "Ask customer: \"Is recipient's address still correct?\""
      ]
    },
    {
      "id": "dec_002",
      "name": "Recipient Address Correctness Gate",
      "aliases": [],
      "entity_class": "DECISION_POINT",
      "type": "pass_fail",
      "description": "A decision point based on the customer's response regarding the external recipient's address. If YES, no change is needed; if NO, the customer must initiate a separate update process.",
      "context": [
        "If YES: No change needed",
        "If NO: Customer must update recipient address (separate process)"
      ]
    },
